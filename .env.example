# ── Vercel Dashboard — required environment variables ──
# Set these in your Vercel project dashboard (Settings → Environment Variables)

# Cesium ion access token (required for 3D globe rendering)
# Get one free at https://ion.cesium.com/tokens
VITE_CESIUM_TOKEN=

# aisstream.io API key for vessel tracking (free from https://aisstream.io)
AISSTREAM_API_KEY=

# OpenSky Network credentials (for flights — optional)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# VesselAPI key (replaces aisstream.io — optional, you need one or the other)
VESSEL_API=

# OpenRouter API key (for AI query features — optional)
OPENROUTER_API_KEY=

# ── Redis (Upstash on Vercel) ──────────────────────────
# Create a Redis database at https://console.upstash.com/ then set:
REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379

# Or use Vercel KV → https://vercel.com/docs/storage/vercel-kv
# KV_URL=...